rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return signedIn() && me().status == "active";
    }

    function admin() {
      return active() && me().roles.systemAdmin == true;
    }

    function cr() {
      return active() && me().roles.cr == true;
    }

    function wingPoc(wingId) {
      return active() && me().scopes.wingPocWings[wingId] == true;
    }

    function subjectPoc(offeringId) {
      return active() && me().scopes.subjectPocOfferings[offeringId] == true;
    }

    function managesTask(data) {
      return active() && (
        (data.target.kind == "wing" && me().scopes.wingPocWings[data.target.wingId] == true) ||
        (data.target.kind == "subject_offering" && me().scopes.subjectPocOfferings[data.target.subjectOfferingId] == true)
      );
    }

    function managesAssignment(data) {
      return active() && (
        (data.wingId != null && me().scopes.wingPocWings[data.wingId] == true) ||
        (data.subjectOfferingId != null && me().scopes.subjectPocOfferings[data.subjectOfferingId] == true)
      );
    }

    function hasAssignment(taskId) {
      return exists(/databases/$(database)/documents/taskAssignments/$(taskId + "_" + request.auth.uid));
    }

    match /appConfig/{document=**} {
      allow read: if active();
      allow write: if false;
    }

    match /academicTerms/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /sections/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /wings/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /subjectOfferings/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /pocAssignments/{id} {
      allow read: if admin() || cr();
      allow write: if false;
    }

    match /timetableSlots/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /timetableExceptions/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /academicEvents/{id} {
      allow read: if active() && (
        admin() || cr() || resource.data.sectionId == me().sectionId ||
        subjectPoc(resource.data.offeringId)
      );
      allow write: if false;
    }

    match /competitions/{id} {
      allow read: if active() && (resource.data.status == "published" || resource.data.status == "in_progress" || resource.data.status == "completed" || admin() || cr());
      allow write: if false;
    }

    match /internships/{id} {
      allow read: if active() && (resource.data.status == "published" || resource.data.status == "completed" || admin() || cr());
      allow write: if false;
    }

    match /opportunityResponses/{id} {
      allow read: if active() && (admin() || cr() || resource.data.uid == request.auth.uid || wingPoc(resource.data.wingId));
      allow write: if false;
    }

    match /internshipResponses/{id} {
      allow read: if active() && (admin() || cr() || resource.data.uid == request.auth.uid || wingPoc(resource.data.wingId));
      allow write: if false;
    }

    match /competitionTeams/{id} {
      allow read: if active() && (admin() || cr() || request.auth.uid in resource.data.memberUids);
      allow write: if false;
    }

    match /competitionMemberships/{id} {
      allow read: if active() && (admin() || cr() || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /competitionRounds/{id} {
      allow read: if active() && (admin() || cr() || resource.data.status == "open" || resource.data.status == "finalized");
      allow write: if false;
    }

    match /competitionRoundEntries/{id} {
      allow read: if active() && (admin() || cr() || request.auth.uid in resource.data.memberUids);
      allow write: if false;
    }

    match /competitionStats/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /internshipStats/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /competitionRoundStats/{id} {
      allow read: if active();
      allow write: if false;
    }

    match /competitionTeamNames/{id} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow get: if active() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;

      match /notifications/{notificationId} {
        allow read: if active() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /tasks/{taskId} {
      allow get: if active() && (
        admin() || cr() || resource.data.ownerUid == request.auth.uid ||
        managesTask(resource.data) || hasAssignment(taskId)
      );
      allow list: if active() && (
        admin() || cr() || resource.data.ownerUid == request.auth.uid ||
        managesTask(resource.data)
      );
      allow write: if false;
    }

    match /taskAssignments/{assignmentId} {
      allow get: if active() && (
        admin() || cr() || resource.data.uid == request.auth.uid || managesAssignment(resource.data)
      );
      allow list: if active() && (
        admin() || cr() || resource.data.uid == request.auth.uid || managesAssignment(resource.data)
      );
      allow write: if false;
    }

    match /taskStats/{taskId} {
      allow read: if active() && (
        admin() || cr() ||
        get(/databases/$(database)/documents/tasks/$(taskId)).data.ownerUid == request.auth.uid ||
        managesTask(get(/databases/$(database)/documents/tasks/$(taskId)).data)
      );
      allow write: if false;
    }

    match /crTasks/{taskId} {
      allow read: if admin() || cr();
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if admin() || cr();
      allow write: if false;
    }

    match /operations/{id} {
      allow read: if admin() || cr() || (active() && resource.data.get("actorUid", "") == request.auth.uid) || (active() && resource.data.get("reporterUid", "") == request.auth.uid);
      allow write: if false;
    }

    match /reminderJobs/{id} {
      allow read: if admin();
      allow write: if false;
    }

    match /reminderDeliveries/{id} {
      allow read: if admin();
      allow write: if false;
    }

    match /systemHealth/{id} {
      allow read: if admin();
      allow write: if false;
    }

    match /pushSubscriptions/{id} {
      allow read, write: if false;
    }

    match /pushEndpointOwners/{id} {
      allow read, write: if false;
    }

    match /pushJobs/{id} {
      allow read, write: if false;
    }

    match /pushDeliveries/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
