  "narrative": {
    "northStar": "The Academic Register",
    "overview": "DeadlineOS uses the character of an academic register: warm cream pages, deep vermilion navigation, expressive Fraunces headings and precise IBM Plex Sans interface data. Actual work remains visible through readable records, aligned dates and direct actions.\n\nThe implementation is flat and practical. Fine rules structure records; darker boundaries identify controls. The user rejected the earlier generic blue/sans-serif appearance and asked mainly for a visual-style change, so established workflows and information layout remain intact. The source of truth is `apps/web/src/app/daybook.css`; surface composition is recorded separately in `.impeccable/surfaces/dashboard.md`.",
    "keyCharacteristics": [
      "Expressive Fraunces headings paired with readable Plex data.",
      "Vermilion identity surfaces, cream fields and dark warm ink.",
      "Flat records with fine rules and stronger interactive boundaries.",
      "Live India-date stamps and consistent authored outline SVG icons."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Overdue, cancelled and other states retain visible text. Red and amber support those labels; color alone does not communicate status.",
        "section": "colors"
      },
      {
        "name": "The Control Boundary Rule",
        "body": "Use the darker control-boundary token for outlined controls; the lighter line token belongs to decorative separators.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Fraunces for headings, prominent dates and management record titles. Use Plex for actions, field values, student task details and dense tables.",
        "section": "typography"
      },
      {
        "name": "The Flat Records Rule",
        "body": "Give a record its rule and spacing before adding a container. Reserve the soft downward shadow for floating action menus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do place the real title, state, date and action in a readable record.",
      "Do use Fraunces headings and Plex data according to their roles.",
      "Do retain visible labels, keyboard focus and explicit failure recovery.",
      "Do keep control boundaries stronger than decorative row rules."
    ],
    "donts": [
      "Don't add decorative gradients, floating statistics or icon mosaics to working screens.",
      "Don't replace meaningful content with generic marketing copy.",
      "Don't rely on color alone for status.",
      "Don't introduce eyebrow labels, glyph icons or ornamental shadows."
    ]
  }
